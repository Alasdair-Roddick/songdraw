# Postgres — hosted Supabase, every environment. Session/transaction pooler URI
# from Supabase dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Realtime — invite notifications. Project Settings → API.
# Realtime here is only a wake-up ping on an unguessable per-user channel; the
# invite data itself always comes from our own authed API. See lib/realtime.ts.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
# Derives those channel names. Any long random string; `openssl rand -hex 32`.
# Changing it silently re-keys every channel — clients reconnect on next load.
REALTIME_CHANNEL_SECRET=changeme

# Object storage — profile pictures. Cloudflare R2 (S3-compatible).
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET=song-draw
# Public base URL objects are served from — no trailing slash. Object URLs are
# `${S3_PUBLIC_URL}/avatars/<user-id>/<uuid>.<ext>`. If the R2 custom domain is
# bound straight to the bucket, this is just the domain. If it resolves a level
# above (or you're pointing at the S3 endpoint / r2.dev), append the bucket
# name: https://avatars.roddickshare.space/song-draw
S3_PUBLIC_URL=https://avatars.roddickshare.space/song-draw

# Dev only. Outside production the 17:00 Adelaide reveal/guess deadline is OFF
# by default (rounds reveal only once everyone has guessed), so testing in the
# evening still works. Set this to exercise the deadline itself — 17 for real
# behaviour, 0 to force everything revealed. Ignored in production.
# DEV_REVEAL_HOUR=17
# Development-only destructive round controls. Put this in `.env.local`, never
# in production. Production ignores it even when set.
# DEV_MODE=true

# cron service — must match the token the app checks on /api/internal/draw
CRON_TOKEN=changeme

# ntfy base URL for ops alerts (song-pool-dry, song-draw-failed). Unset = no
# alerts; the draw job still runs.
NTFY_URL=http://ntfy


# Better Auth
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=https://song.roddickshare.space
