# Postgres (db service)
POSTGRES_USER=songdraw
POSTGRES_PASSWORD=songdraw
POSTGRES_DB=songdraw
DATABASE_URL=postgres://songdraw:songdraw@db:5432/songdraw

# Object storage — profile pictures. Cloudflare R2 (S3-compatible).
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET=song-draw
# Public base URL objects are served from — no trailing slash. Object URLs are
# `${S3_PUBLIC_URL}/avatars/<user-id>/<uuid>.<ext>`. If the R2 custom domain is
# bound straight to the bucket, this is just the domain. If it resolves a level
# above (or you're pointing at the S3 endpoint / r2.dev), append the bucket
# name: https://avatars.roddickshare.space/song-draw
S3_PUBLIC_URL=https://avatars.roddickshare.space/song-draw

# cron service — must match the token the app checks on /api/internal/draw
CRON_TOKEN=changeme


# Better Auth
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=https://song.roddickshare.space